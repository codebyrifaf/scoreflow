// Prisma schema for ScoreFlow.
//
// This describes our database tables and generates a fully type-safe client.
// The connection string (DATABASE_URL) is NOT written here — it's supplied by
// `prisma.config.ts` for CLI commands (migrate/generate/studio) and by the
// runtime adapter in `lib/prisma.ts` for the app. See those files.

// Prisma 7 generates the client as TypeScript into our project (this folder is
// git-ignored and rebuilt by `prisma generate`). We import it from
// `generated/prisma/client` (see lib/prisma.ts).
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A restaurant using ScoreFlow. Milestone 4 introduced this table so the app
/// can serve MANY restaurants, each identified in the URL by its `slug`
/// (e.g. /r/fucco/dashboard). One restaurant has many feedback submissions.
model Restaurant {
  id              Int        @id @default(autoincrement())
  slug            String     @unique // URL-safe id, e.g. "fucco"
  name            String // display name, e.g. "Fucco"
  // A restaurant is a BRANCH of a Brand (Milestone 16 — multi-location chains).
  // NULLABLE: standalone venues (e.g. Fucco) have no brand and work exactly as
  // before. The customer URL stays flat (/r/<slug>/…) so existing NFC chips work.
  brandId         Int?
  brand           Brand?     @relation(fields: [brandId], references: [id])
  googleReviewUrl String? // optional; the thank-you screen's review link
  // Smart review routing (Milestone 7): the MINIMUM rating (1–10) that gets sent
  // to the Google review page after submitting. Ratings at or above this go to
  // the public-review nudge; ratings below it get a private "sorry" screen and
  // are NEVER nudged toward a public review. Default 8 → 8/9/10 go to Google.
  reviewThreshold Int        @default(8)
  // COMPLAINT level (Milestone 18): a rating AT OR BELOW this means the diner is
  // genuinely unhappy — it lands in the owner's "Needs attention" list and fires an
  // alert. Deliberately SEPARATE from `reviewThreshold` (8), which only decides who
  // gets nudged toward Google. If we alerted on "didn't earn a Google invite", a
  // 7/10 — a perfectly good meal — would email the owner, they'd drown in noise and
  // mute alerts within a week. Two different jobs, two different numbers.
  alertThreshold  Int        @default(5)
  createdAt       DateTime   @default(now())
  feedback        Feedback[] // back-relation: all feedback for this restaurant
  owners          Owner[] // back-relation: the login accounts that own this restaurant (Milestone 5)
  tables          Table[] // back-relation: the restaurant's tables + their NFC links (Milestone 8)
}

/// A physical TABLE in a restaurant (Milestone 8 — NFC links).
///
/// Each table gets an NFC chip programmed with a link to the feedback form,
/// pre-filled with this table (e.g. /r/fucco/feedback?table=Patio%202). The
/// owner manages this list at /r/[slug]/tables and copies each link onto a chip.
///
/// `label` is whatever the owner calls the table ("1", "Patio 2"). It's what goes
/// in the link's `?table=` value, and what shows up on each feedback submission.
/// `@@unique([restaurantId, label])` stops one restaurant having two tables with
/// the same name (two restaurants CAN both have a "Table 1" — that's fine).
model Table {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  label        String // e.g. "1" or "Patio 2"
  createdAt    DateTime   @default(now())

  @@unique([restaurantId, label])
}

/// A restaurant OWNER's login account (Milestone 5 — authentication).
///
/// This is the table that makes the owner dashboard private. An owner signs in
/// with `email` + password; we store only a bcrypt HASH of the password
/// (`passwordHash`), never the password itself, so even someone who reads the
/// database can't recover it.
///
/// The relation:
///   `restaurantId` is a foreign key pointing at `Restaurant.id`. It's what ties
///   an owner to the ONE restaurant they're allowed to see. This is a
///   many-to-one relation (an Owner belongs to exactly one Restaurant; a
///   Restaurant has a list of `owners`), exactly like `Feedback → Restaurant`.
///   For now we seed one owner per restaurant. If you ever want to *guarantee*
///   at most one owner per restaurant at the database level, add `@unique` to
///   `restaurantId` below (that turns it into a strict one-to-one relation).
///
/// Security note: the dashboard trusts this `restaurantId` (read from the signed
/// session on the server), NOT anything the browser sends. That's what stops one
/// owner from viewing another restaurant's dashboard.
/// An OWNER/MANAGER login account (Milestone 5; extended for chains in M16).
///
/// An owner is scoped to EITHER a single branch OR a whole brand — exactly one of
/// `restaurantId` / `brandId` is set (enforced in application code, see auth.ts):
///   • `restaurantId` set → a BRANCH MANAGER: sees that one branch's dashboard + tables.
///   • `brandId` set       → a BRAND OWNER: sees every branch of that brand at /b/<slug>.
/// Both are NULLABLE now so a brand owner isn't tied to one restaurant; existing
/// single-venue owners keep `restaurantId` and behave exactly as before.
model Owner {
  id           Int         @id @default(autoincrement())
  email        String      @unique // login identifier, e.g. "owner@fucco.test"
  passwordHash String // bcrypt hash of the password — never the raw password
  restaurantId Int? // FK: the single branch this manager runs (branch-scoped)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  brandId      Int? // FK: the brand this owner runs (brand-scoped)
  brand        Brand?      @relation(fields: [brandId], references: [id])
  // SESSION REVOCATION (Milestone 17). Sessions are stateless JWTs, so there's no
  // "sessions" table to delete a row from. Instead every token carries the
  // tokenVersion it was minted with, and the guards compare it against this column
  // on EVERY request. Bump this (password change / reset) and every existing
  // session for this account dies instantly, on every device.
  tokenVersion Int         @default(0)
  // NOTIFICATION PREFERENCES (Milestone 18) — per PERSON, not per restaurant, so
  // each manager controls their own inbox.
  //   • alertsEnabled → email me the moment a diner is unhappy (instant).
  //   • digestEnabled → email me ONE summary a day instead.
  // The defaults differ by scope and are set at ACCOUNT CREATION, not here:
  //   branch manager → instant on, digest off  (they can fix it tonight)
  //   brand owner    → instant OFF, digest on  (a 4-branch owner getting 20 instant
  //                    emails a day would just mute everything and see nothing)
  alertsEnabled Boolean    @default(true)
  digestEnabled Boolean    @default(false)
  createdAt    DateTime    @default(now())
}

/// A BRAND — a chain that groups several branches (Milestone 16).
///
/// "KFC" is a Brand; each location ("KFC Gulshan", "KFC Uttara") is a `Restaurant`
/// (a branch) with `brandId` pointing here. A brand has one brand-owner `Owner`
/// (brand-scoped) who sees all branches at /b/<slug>; each branch has its own
/// branch-manager `Owner` (branch-scoped). The operator creates brands at /admin.
model Brand {
  id          Int          @id @default(autoincrement())
  slug        String       @unique // URL-safe id, e.g. "kfc"
  name        String // display name, e.g. "KFC"
  createdAt   DateTime     @default(now())
  restaurants Restaurant[] // back-relation: the brand's branches
  owners      Owner[] // back-relation: brand-scoped login(s)
}

/// A platform OPERATOR's login account (Milestone 6 — admin dashboard).
///
/// The operator is YOU (whoever runs ScoreFlow), not a restaurant. Operators log
/// in at the same /login page as owners, but they're a DIFFERENT kind of account:
/// they don't belong to any restaurant — instead they manage the whole list of
/// restaurants at /admin (view all, add new ones + create each one's owner login).
///
/// Why a separate table (instead of a flag on Owner)? It keeps the meaning of
/// each model crisp: `Owner` = "runs one restaurant", `Operator` = "runs the
/// platform". The login code (auth.ts) checks operators first, then owners, and
/// tags the session with a `role` so pages know which kind of user is signed in.
///
/// Like Owner, we store only a bcrypt HASH of the password, never the password.
model Operator {
  id           Int      @id @default(autoincrement())
  email        String   @unique // login identifier, e.g. "operator@scoreflow.test"
  passwordHash String // bcrypt hash of the password — never the raw password
  // Session revocation — see the note on Owner.tokenVersion (Milestone 17).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
}

/// A FAILED login attempt — the brute-force guard (Milestone 17).
///
/// Before M17 there was NO rate limit on login at all: an attacker could POST
/// /api/auth/callback/credentials forever, guessing the operator's password (and
/// burning a bcrypt compare — i.e. our CPU — on every guess). Now `authorize()`
/// counts recent failures here BEFORE doing any bcrypt work, and refuses when a
/// threshold is crossed.
///
/// Only FAILURES are stored, and a successful login clears that email's rows.
/// Lockouts are short and AUTO-EXPIRING (we only ever count rows newer than the
/// window), so nobody needs an admin to unlock them. Old rows are pruned
/// opportunistically. We store a salted hash of the IP, never the raw IP.
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String // normalised: trimmed + lowercased
  ipHash    String // salted SHA-256 of the caller's IP
  createdAt DateTime @default(now())

  // The two lookups the guard makes: "recent failures for this email?" and
  // "recent failures from this IP?".
  @@index([email, createdAt])
  @@index([ipHash, createdAt])
}

/// One customer feedback submission, belonging to exactly one Restaurant.
///
/// Milestone 4: the old free-text `restaurant` string was replaced by a real
/// `restaurantId` foreign key + relation to `Restaurant`. That's what keeps each
/// restaurant's data isolated — reads/writes filter on `restaurantId`.
///
/// How the columns map to the `FeedbackRecord` TypeScript type (lib/types.ts):
///   id          -> (database primary key; not in FeedbackRecord)
///   restaurantId-> (the owning restaurant; not shown per-row in the dashboard)
///   table       -> table        (string | null — the URL's ?table= value)
///   orderNumber -> orderNumber  (string)
///   rating      -> rating       (number, 1–10)
///   comment     -> comment      (string, may be empty "")
///   createdAt   -> timestamp    (Date in the DB; converted to an ISO string)
model Feedback {
  id           Int        @id @default(autoincrement())
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  table        String?
  orderNumber  String
  rating       Int
  comment      String     @default("")
  // Quick-tap suggestion chips the customer selected (Milestone 9), e.g.
  // ["Slow service", "Food was cold"]. Empty when they picked none.
  tags         String[]   @default([])
  // Hashed caller IP (Milestone 13 — spam guard). We store only a salted SHA-256
  // hash, never the raw IP, and use it to rate-limit submissions. Null for older
  // rows / when no IP is available.
  ipHash       String?
  // THE "NEEDS ATTENTION" WORKLIST (Milestone 18). A complaint (rating ≤ the
  // restaurant's alertThreshold) stays OPEN until someone deals with it. This is
  // what turns a notification into a workflow: the owner works through unhappy
  // diners and closes them off, rather than just being pinged.
  resolvedAt   DateTime? // null = still open
  resolvedBy   String? // the owner email that closed it
  // Stamped once this row has been included in an alert email, so a diner is never
  // reported twice (alerts are BATCHED — see lib/notifications.ts).
  alertedAt    DateTime?
  createdAt    DateTime   @default(now())

  // Speeds up the "how many recent submissions from this IP?" rate-limit query.
  @@index([ipHash, createdAt])
  // The worklist query: "this restaurant's still-open complaints".
  @@index([restaurantId, resolvedAt])
  // THE app's hottest query: "all feedback for restaurant X" (every dashboard load)
  // and "recent feedback for restaurant X" (the spam guard). Postgres does NOT
  // auto-index a foreign key, so before M17 this was a sequential scan over EVERY
  // tenant's rows — it got slower for each customer as OTHER customers grew.
  @@index([restaurantId, createdAt])
}
