# ScoreFlow environment variables — COPY this file to `.env` and fill in real values.
# `.env` is git-ignored; this example is committed so you always know what's needed.
# NEVER put real secrets in this file.

# ── Database (required) ──────────────────────────────────────────────────────
# Your Neon Postgres connection string. Use the POOLED endpoint (host contains
# "-pooler") and sslmode=verify-full.
# ⚠️ Local dev should point at your Neon DEV BRANCH, never production. Run
# `npm run db:where` to check which database you're aimed at before anything risky.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# ── Auth (required) ──────────────────────────────────────────────────────────
# Signs the session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Salts the hashed IPs used by the spam guard. Optional but recommended: if unset it
# falls back to AUTH_SECRET, which means rotating AUTH_SECRET (the emergency "sign
# everyone out" lever) would ALSO wipe the spam guard's memory of every IP it was
# throttling — at exactly the moment you're under attack. Keep them separate.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# ⚠️ LEAVE IT COMMENTED OUT rather than setting it to "". This line used to read
# `IP_HASH_SALT=""`, and an empty value is NOT the same as unset — it produced an
# empty salt, i.e. plain unsalted SHA-256 of the IP, which is reversible with a
# rainbow table (there are only ~4.3bn IPv4 addresses). lib/request-ip.ts now treats
# empty as unset too, but don't rely on that: just set a real value or omit the line.
# IP_HASH_SALT=""

# ── Email / alerts (optional) ────────────────────────────────────────────────
# Unhappy-diner alerts + the daily digest go out through this. With EMAIL_PROVIDER
# UNSET, the app LOGS each message instead of sending (safe default — you can watch
# alerts fire in the terminal with no account or domain).
#
# Option A — Gmail (free, no domain, good for early pilots):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Fill in the three lines below.
#   Test it:  npm run email:test you@example.com
EMAIL_PROVIDER=""                 # "gmail" to send via Gmail; "resend" later; empty = log only
GMAIL_USER=""                     # the full Gmail address, e.g. you@gmail.com
GMAIL_APP_PASSWORD=""             # the 16-char App Password (NOT your normal password)
EMAIL_FROM="ScoreFlow <you@gmail.com>"   # display name shown in the inbox

# Option B — Resend (needs a domain you own; for when you're charging money):
#   set EMAIL_PROVIDER=resend and add:
# RESEND_API_KEY=""

# Public base URL, used in the links inside alert emails. On Vercel this is set
# automatically (VERCEL_URL); set it explicitly for local testing if you like.
# APP_URL="http://localhost:3000"

# ── Seed / operator (used by `npm run seed`, mostly in production) ────────────
# The platform operator (admin) login. In production, set a STRONG password here.
OPERATOR_EMAIL="operator@scoreflow.test"
OPERATOR_PASSWORD=""              # required in production; the seed refuses to print it
# SEED_DEMO="true"                # also create the demo fucco/bella restaurants (dev only)
# SEED_FORCE="true"              # override the "refusing to seed real data" guardrail

# ── Cron (optional, for the daily digest job) ────────────────────────────────
# Protects GET /api/cron/digest so only your scheduler can trigger it.
CRON_SECRET=""
